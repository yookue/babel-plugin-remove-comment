{
    "name": "@unikue/babel-plugin-remove-comment",
    "version": "1.0.0",
    "title": "BabelPluginRemoveComment",
    "description": "Removes script comments during babel compilation",
    "homepage": "https://unikueltd.github.io/babel-plugin-remove-comment",
    "organization": "Unikue Ltd",
    "private": false,
    "license": "MIT",
    "keywords": [
        "babel",
        "babel-plugin",
        "babel-plugin-remove-comment"
    ],
    "files": [
        "dist"
    ],
    "main": "dist/cjs/index.js",
    "types": "dist/cjs/index.d.ts",
    "sideEffects": false,
    "scripts": {
        "build": "del-cli ./dist && tsc --outDir ./dist/cjs",
        "docs:build": "typedoc --out ./docs-dist",
        "docs:publish": "gh-pages -d ./docs-dist",
        "lint": "eslint \"{src,test}/**/*.{js,jsx,ts,tsx}\"",
        "test": "jest",
        "test:coverage": "del-cli ./coverage && jest --coverage --coverageDirectory ./coverage"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.28.3",
        "@types/babel__core": "^7.20.5",
        "@types/jest": "^30.0.0",
        "@typescript-eslint/eslint-plugin": "^8.43.0",
        "@unikue/typedoc-plugin-raw-content": "~1.0.0",
        "del-cli": "^6.0.0",
        "gh-pages": "^6.3.0",
        "ts-jest": "^29.4.1",
        "typedoc": "~0.28.12",
        "typescript": "^5.9.2"
    },
    "peerDependencies": {
        "typescript": ">=4"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/unikueltd/babel-plugin-remove-comment.git"
    },
    "bugs": {
        "url": "https://github.com/unikueltd/babel-plugin-remove-comment/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
