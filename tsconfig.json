{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "target": "es2020",
        "lib": ["dom"],
        "declaration": true,
        "esModuleInterop": true,
        "ignoreDeprecations": "6.0",
        "module": "commonjs",
        "moduleResolution": "node10",
        "noImplicitAny": false,
        "noUnusedLocals": true,
        "removeComments": true,
        "skipLibCheck": true,
        "strict": true,
        "types": ["node", "jest"]
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules",
        "coverage",
        "dist",
        "docs-dist"
    ]
}
